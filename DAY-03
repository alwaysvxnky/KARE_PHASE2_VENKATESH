// C-L0-MOD2-Conditional-Challenge-1
//Write a java program to check the values are equal or not
import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {

    public static void main(String[] args) {
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Solution. */
        Scanner obj = new Scanner(System.in);
        int a = obj.nextInt();
        int b =obj.nextInt();
        if(a==b)
            System.out.println("EQUAL");
        else
            System.out.println("NOT EQUAL");
            
    }
}

//C-L0-MOD2-Conditional-Challenge-2
//Write a JAVA program to check the number is odd or even using conditional construct

import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {

    public static void main(String[] args) {
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Solution. */
        Scanner sc= new Scanner(System.in);
        int a = sc.nextInt();
        if(a%2==0)
            System.out.println("EVEN");
        else
            System.out.println("ODD");
    }
}
//C-L0-MOD2-Conditional-Challenge-3
//Write a JAVA program to determine the sign of the input using conditional constructs.

import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {

    public static void main(String[] args) {
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Solution. */
        Scanner sc= new Scanner(System.in);
        int a = sc.nextInt();
        if(a>0)
            System.out.println("Positive");
        else if(a==0)
            System.out.println("Zero");
        else if(a<0) 
            System.out.println("Negative");
    }
}

//C-L0-MOD2-Conditional-Challenge-4
//Write a C program to check the number is divisible by 3 or not using conditional construct.
import java.io.*;
import java.util.*;
import java.text.*;
import java.math.*;
import java.util.regex.*;

public class Solution {

    public static void main(String[] args) {
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Solution. */
        Scanner  scanner = new Scanner(System.in);
        int num1 = scanner.nextInt();
        
        if(num1%3==0)
            System.out.println("The number is divisible by 3");
        else
            System.out.println("The number is not divisible by 3 and gives a remainder "+num1%3);
    }
}
