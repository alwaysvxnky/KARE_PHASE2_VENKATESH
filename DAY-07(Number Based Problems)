// 10 AUTOMORPHIC NUMBER
// Write a Java program to check whether the given number is an automorphic number or not.
// Input: 25
// Square = 625
// Last digits of square = 25
// Output: AUTOMORPHIC NUMBER

import java.util.*;

public class Main
{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int temp = n;
        int square = n * n;
        int d1 = 0, d2 = 0;

        while(n != 0) {
            d1++;
            n = n / 10;
        }

        int power = 1;
        for(int i = 1; i <= d1; i++) {
            power = power * 10;
        }

        d2 = square % power;

        if(temp == d2) {
            System.out.println("AUTOMORPHIC NUMBER");
        } else {
            System.out.println("NOT AN AUTOMORPHIC NUMBER");
        }
    }
}


