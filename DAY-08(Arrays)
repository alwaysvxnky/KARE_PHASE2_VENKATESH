import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    Scanner sc=new Scanner(System.in);
	    int n=sc.nextInt();
	    int sum=0;
	    int arr[]= new int[n];
	    int i;
	    for(i=0;i<n;i++){
	        arr[i]=sc.nextInt();
	        sum=sum+arr[i];
	    }
	   System.out.println("Sum of Array Elements : "+sum);
	}
}
