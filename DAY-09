import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        int i;int sum=0;
        for ( i = 0; i < n-1; i++) {
            arr[i] = sc.nextInt();
            sum=sum+arr[i];
        }
        int sumn=n*(n+1)/2;
        int r=sumn-sum;
        System.out.println("Missing Number : "+r);
    }
}

