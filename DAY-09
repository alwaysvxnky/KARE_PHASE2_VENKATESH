5
2 4 2 4 3
3

import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        int i;int m=0;
        for ( i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }
        for(i=0;i<n;i++){
            m=m^arr[i];
        }
        System.out.println(m);
    }
}
