import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter no of rows : ");
        int row = sc.nextInt();
        System.out.println("Enter no of rows : ");
        int col = sc.nextInt();
        int arr[][]=new int[row][col];
        System.out.println("Enter elements of Array : ");
        for(int i=0;i<row;i++){
            for(int j=0;j<col;j++){
                arr[i][j] = sc.nextInt();
            }
        }
        System.out.println("Elements in the Array : ");
        for(int i=0;i<row;i++){
            for(int j=0;j<col;j++){
              System.out.print(arr[i][j]+" ");
            }
            System.out.println();
        }
        
    }
}
//Write a java program to get sum of array elements
Enter no of rows : 
2
Enter no of rows : 
3
Enter elements of Array : 
10 20 30 40 50 60
Elements in the Array : 
10 20 30 
40 50 60 
Sum of Elements in Array : 210

//write a java to create and display a 2D array

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("Enter no of rows : ");
        int row = sc.nextInt();
        System.out.println("Enter no of rows : ");
        int col = sc.nextInt();
        int arr[][]=new int[row][col];
        int sum=0;
        System.out.println("Enter elements of Array : ");
        for(int i=0;i<row;i++){
            for(int j=0;j<col;j++){
                arr[i][j] = sc.nextInt();
            }
        }
        System.out.println("Elements in the Array : ");
        for(int i=0;i<row;i++){
            for(int j=0;j<col;j++){
              System.out.print(arr[i][j]+" ");
            }
            System.out.println();
        }
        for(int i=0;i<row;i++){
            for(int j=0;j<col;j++){
              sum=sum+arr[i][j];
            }  
        }
        System.out.println("Sum of Elements in Array : "+sum); 
    }
}
