// Binary Search in Descending Array
import java.util.*;

public class Main
{
    public static void main(String[] args) {

        int arr[] = {50, 40, 30, 20, 10};
        int target = 20;

        int low = 0;
        int high = arr.length - 1;
        int flag = 0;

        while(low <= high){

            int mid = low + (high - low) / 2;

            if(arr[mid] == target){
                System.out.print("Target found at index : " + mid);
                flag = 1;
                break;
            }
            else if(target < arr[mid]){
                low = mid + 1;
            }
            else{
                high = mid - 1;
            }
        }

        if(flag == 0){
            System.out.print("Target not found");
        }
    }
}


//08
// Search in 2D Array
import java.util.*;

public class Main
{
    public static void main(String[] args) {

        int arr[][] = {
            {10, 20, 30},
            {40, 50, 60},
            {70, 80, 90}
        };

        int target = 50;
        int flag = 0;

        for(int i = 0; i < arr.length; i++){

            for(int j = 0; j < arr[i].length; j++){

                if(arr[i][j] == target){
                    System.out.print("Target found at : " + i + "," + j);
                    flag = 1;
                    break;
                }
            }

            if(flag == 1)
                break;
        }

        if(flag == 0)
            System.out.print("Target not found");
    }
}

