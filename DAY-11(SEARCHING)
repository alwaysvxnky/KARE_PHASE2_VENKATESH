//04
// First Occurrence using Binary Search
import java.util.*;

public class Main
{
    public static void main(String[] args) {

        int arr[] = {10, 20, 20, 20, 30};
        int target = 20;

        int low = 0;
        int high = arr.length - 1;
        int ans = -1;

        while(low <= high){

            int mid = low + (high - low) / 2;

            if(arr[mid] == target){
                ans = mid;
                high = mid - 1;
            }
            else if(target > arr[mid]){
                low = mid + 1;
            }
            else{
                high = mid - 1;
            }
        }

        System.out.print("First occurrence : " + ans);
    }
}

