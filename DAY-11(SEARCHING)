//06
// Count Occurrences
import java.util.*;

public class Main
{
    public static void main(String[] args) {

        int arr[] = {10, 20, 20, 20, 30};
        int target = 20;

        int low = 0;
        int high = arr.length - 1;
        int first = -1;

        while(low <= high){

            int mid = low + (high - low) / 2;

            if(arr[mid] == target){
                first = mid;
                high = mid - 1;
            }
            else if(target > arr[mid]){
                low = mid + 1;
            }
            else{
                high = mid - 1;
            }
        }

        low = 0;
        high = arr.length - 1;
        int last = -1;

        while(low <= high){

            int mid = low + (high - low) / 2;

            if(arr[mid] == target){
                last = mid;
                low = mid + 1;
            }
            else if(target > arr[mid]){
                low = mid + 1;
            }
            else{
                high = mid - 1;
            }
        }

        if(first == -1)
            System.out.print("Target not found");
        else
            System.out.print("Count : " + (last - first + 1));
    }
}

