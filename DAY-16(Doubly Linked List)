//Search an element in Doubly Linked List

import java.util.*;

class Node{
    int data;
    Node next;
    Node previous;

    Node(int d){
        this.data=d;
        this.next=null;
        this.previous=null;
    }
}

public class Main
{
    public static void main(String[] args) {

        Scanner sc=new Scanner(System.in);
        Main m=new Main();

        int d=sc.nextInt();

        while(d!=-1){
            m.insert(d);
            d=sc.nextInt();
        }

        m.search();
    }

    Node first;

    void insert(int d){

        Node n=new Node(d);

        if(first==null){
            first=n;
            return;
        }

        Node temp=first;

        while(temp.next!=null){
            temp=temp.next;
        }

        temp.next=n;
        n.previous=temp;
    }

    void search(){

        Scanner sc=new Scanner(System.in);

        int s=sc.nextInt();
        int flag=0;

        if(first==null){
            System.out.println("List is empty");
            return;
        }

        Node temp=first;

        while(temp!=null){

            if(temp.data==s){
                System.out.println("Element found");
                flag=1;
                break;
            }

            temp=temp.next;
        }

        if(flag==0)
            System.out.println("Element not found");
    }
}

