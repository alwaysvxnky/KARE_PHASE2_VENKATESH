//Search Element in Circular Singly Linked List

import java.util.*;

class Node {
    int data;
    Node next;

    Node(int d) {
        data = d;
        next = null;
    }
}

public class Main {

    public static void main(String[] args) {

        Scanner obj = new Scanner(System.in);
        Main m = new Main();

        int d = obj.nextInt();

        while(d != -1) {
            m.insert(d);
            d = obj.nextInt();
        }

        m.search();
    }

    Node first = null;

    void insert(int d) {

        Node n = new Node(d);

        if(first == null) {
            first = n;
            n.next = first;
            return;
        }

        Node temp = first;

        while(temp.next != first) {
            temp = temp.next;
        }

        temp.next = n;
        n.next = first;
    }

    void search() {

        Scanner obj = new Scanner(System.in);

        int s = obj.nextInt();
        int flag = 0;

        if(first == null) {
            System.out.println("List is empty");
            return;
        }

        Node temp = first;

        do {

            if(temp.data == s) {
                System.out.println("Element found");
                flag = 1;
                break;
            }

            temp = temp.next;

        } while(temp != first);

        if(flag == 0) {
            System.out.println("Element not found");
        }
    }
}


