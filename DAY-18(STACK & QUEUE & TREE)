import java.util.*;

class Stack2 {
    int top = -1;
    int arr[];

    Stack2(int n) {
        arr = new int[n];
    }

    void push(int d) {
        if(top == arr.length-1) {
            System.out.println("Overflow");
            return;
        }
        arr[++top] = d;
    }

    void pop() {
        if(top == -1) {
