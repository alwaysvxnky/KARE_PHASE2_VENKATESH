// Reverse a String using Stack

import java.util.*;

class Stack4 {
    int top = -1;
    char arr[];

    Stack4(int n) {
        arr = new char[n];
    }

    void push(char c) {
        arr[++top] = c;
    }

    char pop() {
        return arr[top--];
    }
}

class Main {
    public static void main(String[] args) {

        String str = "JAVA";

        Stack4 s = new Stack4(str.length());

        for(int i=0; i<str.length(); i++) {
            s.push(str.charAt(i));
        }

        while(s.top != -1) {
            System.out.print(s.pop());
        }
    }
}



