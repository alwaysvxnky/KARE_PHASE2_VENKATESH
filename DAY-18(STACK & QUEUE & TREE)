import java.util.*;
class Queue {
    int front,rear;
    int n;
    int queue[];
    Queue(int n){
        this.n=n;
        queue = new int[n];
        front=0;
        rear=-1;
    }
    void enqueue(int data){
        if(rear==n-1){
            System.out.println("Queue is full");
            return;
        }
        rear++;
        queue[rear]=data;
    }
    int dequeue(){
        if(front>rear){
            System.out.println("Queue is empty");
            return -1;
        }
        return queue[front++];
    }
    void display() {
        if(front > rear){
            System.out.println("Queue is empty");
            return;
        }
        for(int i=front;i<=rear;i++){
            System.out.print(queue[i]+" ");
        }
        System.out.println();
        return;
    }
}
public class Main
{
