//07
// Count total edges in an undirected graph

import java.util.*;

class Main {
    public static void main(String[] args) {

        Scanner obj = new Scanner(System.in);

        int V = obj.nextInt();
        int E = obj.nextInt();

        int[][] graph = new int[V][V];

        for(int i = 0; i < E; i++) {

            int u = obj.nextInt();
            int v = obj.nextInt();

            graph[u][v] = 1;
            graph[v][u] = 1;
        }

        int count = 0;

        for(int i = 0; i < V; i++) {

            for(int j = 0; j < V; j++) {

                if(graph[i][j] == 1) {
                    count++;
                }
            }
        }

        System.out.println("Number of edges: " + count / 2);
    }
}


