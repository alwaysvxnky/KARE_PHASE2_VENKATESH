// Program to find degree of each vertex in an undirected graph

import java.util.*;

class Main {
    public static void main(String[] args) {

        Scanner obj = new Scanner(System.in);

        int V = obj.nextInt();
        int E = obj.nextInt();

        int[][] graph = new int[V][V];

        for(int i = 0; i < E; i++) {

            int u = obj.nextInt();
            int v = obj.nextInt();

            graph[u][v] = 1;
            graph[v][u] = 1;
        }

        for(int i = 0; i < V; i++) {

            int degree = 0;

            for(int j = 0; j < V; j++) {

                if(graph[i][j] == 1) {
                    degree++;
                }
            }

            System.out.println("Degree of " + i + ": " + degree);
        }
    }
}


